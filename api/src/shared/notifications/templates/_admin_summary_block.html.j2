{#- Shared admin.event_summary blocks, used by both the single-event and digest templates
    so the markup exists in one place.

    `summary_block` is the entry point: admin.event_summary carries several kinds of report
    (see AdminEventUpdateType), and the entry's subtype decides which block renders it. -#}
{%- import "_seal_summary_block.html.j2" as seal -%}
{%- macro summary_block(entry) -%}
{%- if entry.subtype == "seal_run_summary" -%}
{{ seal.summary_block(entry.summary) }}
{%- else -%}
{{ dispatch_block(entry.summary) }}
{%- endif -%}
{%- endmacro -%}
{%- macro dispatch_block(summary) -%}
<h1 style="margin: 0 0 4px 0; font-family: Mulish, 'Segoe UI', Arial, Helvetica, sans-serif; font-size: 20px; line-height: 1.3; font-weight: 800; color: #1d1717;">Notification Dispatch Summary</h1>
<p style="margin: 0 0 16px 0; font-family: Mulish, 'Segoe UI', Arial, sans-serif; font-size: 13px; color: rgba(71, 71, 71, 0.8);">
  Cadence: <strong style="color: #474747;">{{ summary.cadence | default("-") }}</strong>
</p>
<table
  role="presentation"
  width="100%"
  cellpadding="0"
  cellspacing="0"
  border="0"
  style="background-color: #ffffff; border-radius: 4px; overflow: hidden;"
>
  <thead>
    <tr bgcolor="#ffffff" style="background-color: #ffffff">
      <th align="left" style="padding: 8px 10px; font-family: Mulish, 'Segoe UI', Arial, sans-serif; font-size: 11px; font-weight: 700; color: #474747; border-bottom: 1px solid rgba(0,0,0,0.12);">Metric</th>
      <th align="right" style="padding: 8px 10px; font-family: Mulish, 'Segoe UI', Arial, sans-serif; font-size: 11px; font-weight: 700; color: #474747; border-bottom: 1px solid rgba(0,0,0,0.12);">Count</th>
    </tr>
  </thead>
  <tbody style="font-family: Mulish, 'Segoe UI', Arial, sans-serif; font-size: 12px;">
    <tr><td style="padding: 7px 10px; color: #474747; border-bottom: 1px solid rgba(0,0,0,0.06);">Subscriptions processed</td><td align="right" style="padding: 7px 10px; color: #474747; border-bottom: 1px solid rgba(0,0,0,0.06);">{{ summary.subscriptions_processed | default(0) }}</td></tr>
    <tr bgcolor="#fafafa" style="background-color: #fafafa"><td style="padding: 7px 10px; color: #474747; border-bottom: 1px solid rgba(0,0,0,0.06);">Events found</td><td align="right" style="padding: 7px 10px; color: #474747; border-bottom: 1px solid rgba(0,0,0,0.06);">{{ summary.events_found | default(0) }}</td></tr>
    <tr><td style="padding: 7px 10px; color: #2e7d32; border-bottom: 1px solid rgba(0,0,0,0.06);">Emails sent</td><td align="right" style="padding: 7px 10px; color: #474747; border-bottom: 1px solid rgba(0,0,0,0.06);">{{ summary.emails_sent | default(0) }}</td></tr>
    <tr bgcolor="#fafafa" style="background-color: #fafafa"><td style="padding: 7px 10px; color: #d32f2f; border-bottom: 1px solid rgba(0,0,0,0.06);">Emails failed</td><td align="right" style="padding: 7px 10px; color: #474747; border-bottom: 1px solid rgba(0,0,0,0.06);">{{ summary.emails_failed | default(0) }}</td></tr>
    <tr><td style="padding: 7px 10px; color: #d32f2f; border-bottom: 1px solid rgba(0,0,0,0.06);">Permanently failed</td><td align="right" style="padding: 7px 10px; color: #474747; border-bottom: 1px solid rgba(0,0,0,0.06);">{{ summary.permanently_failed | default(0) }}</td></tr>
    <tr bgcolor="#fafafa" style="background-color: #fafafa"><td style="padding: 7px 10px; color: #ed6c02;">Skipped (max retries)</td><td align="right" style="padding: 7px 10px; color: #474747;">{{ summary.skipped_max_retries | default(0) }}</td></tr>
  </tbody>
</table>
{%- endmacro -%}

{#- Shared "one Seal of Reliability run summary" block, used by both the single-event
    and digest admin.event_summary templates so the markup exists in one place.

    Rendered from the payload the seal orchestrator monitor emits once per nightly run. -#}
{%- macro id_list(label, stable_ids, color) -%}
{%- if stable_ids %}
<p style="margin: 14px 0 4px 0; font-family: Mulish, 'Segoe UI', Arial, sans-serif; font-size: 12px; font-weight: 700; color: {{ color }};">{{ label }} ({{ stable_ids | length }})</p>
<p style="margin: 0; font-family: Mulish, 'Segoe UI', Arial, sans-serif; font-size: 12px; line-height: 1.7; color: #474747;">
  {% for stable_id in stable_ids %}
  <a href="{{ stable_id | feed_page_url }}" style="color: #3859fa; text-decoration: none;">{{ stable_id }}</a>{{ ", " if not loop.last else "" }}
  {% endfor %}
</p>
{% endif -%}
{%- endmacro -%}
{%- macro summary_block(summary) -%}
<h1 style="margin: 0 0 4px 0; font-family: Mulish, 'Segoe UI', Arial, Helvetica, sans-serif; font-size: 20px; line-height: 1.3; font-weight: 800; color: #1d1717;">Seal of Reliability Run Summary</h1>
<p style="margin: 0 0 16px 0; font-family: Mulish, 'Segoe UI', Arial, sans-serif; font-size: 13px; color: rgba(71, 71, 71, 0.8);">
  Run: <strong style="color: #474747;">{{ summary.run_id | default("-") }}</strong> &middot;
  Status: <strong style="color: {{ "#d32f2f" if summary.status == "failed" else "#2e7d32" }};">{{ summary.status | default("-") }}</strong>
</p>
<table
  role="presentation"
  width="100%"
  cellpadding="0"
  cellspacing="0"
  border="0"
  style="background-color: #ffffff; border-radius: 4px; overflow: hidden;"
>
  <thead>
    <tr bgcolor="#ffffff" style="background-color: #ffffff">
      <th align="left" style="padding: 8px 10px; font-family: Mulish, 'Segoe UI', Arial, sans-serif; font-size: 11px; font-weight: 700; color: #474747; border-bottom: 1px solid rgba(0,0,0,0.12);">Metric</th>
      <th align="right" style="padding: 8px 10px; font-family: Mulish, 'Segoe UI', Arial, sans-serif; font-size: 11px; font-weight: 700; color: #474747; border-bottom: 1px solid rgba(0,0,0,0.12);">Count</th>
    </tr>
  </thead>
  <tbody style="font-family: Mulish, 'Segoe UI', Arial, sans-serif; font-size: 12px;">
    <tr><td style="padding: 7px 10px; color: #474747; border-bottom: 1px solid rgba(0,0,0,0.06);">Feeds evaluated</td><td align="right" style="padding: 7px 10px; color: #474747; border-bottom: 1px solid rgba(0,0,0,0.06);">{{ summary.total_feeds_evaluated | default(0) | thousands_sep }}</td></tr>
    <tr bgcolor="#fafafa" style="background-color: #fafafa"><td style="padding: 7px 10px; color: #2e7d32; border-bottom: 1px solid rgba(0,0,0,0.06);">Seals granted</td><td align="right" style="padding: 7px 10px; color: #474747; border-bottom: 1px solid rgba(0,0,0,0.06);">{{ summary.seals_granted | default(0) }}</td></tr>
    <tr><td style="padding: 7px 10px; color: #d32f2f; border-bottom: 1px solid rgba(0,0,0,0.06);">Seals revoked</td><td align="right" style="padding: 7px 10px; color: #474747; border-bottom: 1px solid rgba(0,0,0,0.06);">{{ summary.seals_revoked | default(0) }}</td></tr>
    <tr bgcolor="#fafafa" style="background-color: #fafafa"><td style="padding: 7px 10px; color: #474747; border-bottom: 1px solid rgba(0,0,0,0.06);">Feeds whose page changed</td><td align="right" style="padding: 7px 10px; color: #474747; border-bottom: 1px solid rgba(0,0,0,0.06);">{{ summary.feeds_changed | default(0) | thousands_sep }}</td></tr>
    <tr><td style="padding: 7px 10px; color: #474747; border-bottom: 1px solid rgba(0,0,0,0.06);">Pages revalidated</td><td align="right" style="padding: 7px 10px; color: #474747; border-bottom: 1px solid rgba(0,0,0,0.06);">{{ summary.feeds_revalidated | default(0) | thousands_sep }}</td></tr>
    <tr bgcolor="#fafafa" style="background-color: #fafafa"><td style="padding: 7px 10px; color: #474747; border-bottom: 1px solid rgba(0,0,0,0.06);">Revalidation tasks enqueued</td><td align="right" style="padding: 7px 10px; color: #474747; border-bottom: 1px solid rgba(0,0,0,0.06);">{{ summary.revalidation_tasks | default(0) | thousands_sep }}</td></tr>
    <tr><td style="padding: 7px 10px; color: #d32f2f; border-bottom: 1px solid rgba(0,0,0,0.06);">Batches failed</td><td align="right" style="padding: 7px 10px; color: #474747; border-bottom: 1px solid rgba(0,0,0,0.06);">{{ summary.batches_failed | default(0) }}</td></tr>
    <tr bgcolor="#fafafa" style="background-color: #fafafa"><td style="padding: 7px 10px; color: #ed6c02;">Batches incomplete</td><td align="right" style="padding: 7px 10px; color: #474747;">{{ summary.batches_incomplete | default(0) }}</td></tr>
  </tbody>
</table>
{{ id_list("Seal granted", summary.granted_stable_ids, "#2e7d32") }}
{{ id_list("Seal revoked", summary.revoked_stable_ids, "#d32f2f") }}
{{ id_list("Page revalidated", summary.changed_stable_ids, "#474747") }}
{% if summary.ids_omitted %}
<p style="margin: 12px 0 0 0; font-family: Mulish, 'Segoe UI', Arial, sans-serif; font-size: 11px; color: rgba(71, 71, 71, 0.8);">
  {{ summary.ids_omitted }} further feed id{{ "s" if summary.ids_omitted != 1 else "" }} not listed. The seal tables hold every one.
</p>
{% endif %}
{%- endmacro -%}

{% extends "_base_email.html.j2" %}

{#- A feed's name for subscribers: its provider, falling back to its stable ID. -#}
{%- macro feed_link(url, provider, stable_id) -%}
{%- set name = provider or stable_id or "-" -%}
{%- if url -%}<a href="{{ url }}" target="_blank" style="color: #3959fa; font-weight: 700; text-decoration: none;">{{ name }}</a>{%- else -%}{{ name }}{%- endif -%}
{%- endmacro -%}

{%- macro th(label, align="left") -%}
<th align="{{ align }}" style="padding: 8px 10px; font-family: Mulish, 'Segoe UI', Arial, sans-serif; font-size: 11px; font-weight: 700; color: #474747; border-bottom: 1px solid rgba(0,0,0,0.12);">{{ label }}</th>
{%- endmacro -%}

{%- macro td_style(loop) -%}
padding: 7px 10px; color: #474747;{% if not loop.last %} border-bottom: 1px solid rgba(0,0,0,0.06);{% endif %}
{%- endmacro -%}

{%- macro row_open(loop) -%}
<tr{% if loop.index0 % 2 == 1 %} bgcolor="#fafafa" style="background-color: #fafafa"{% endif %}>
{%- endmacro -%}

{%- macro section_heading(title, count) -%}
<h2 style="margin: 0 0 8px 0; font-family: Mulish, 'Segoe UI', Arial, Helvetica, sans-serif; font-size: 15px; line-height: 1.3; font-weight: 800; color: #1d1717;">{{ title }} ({{ count }})</h2>
{%- endmacro -%}

{% block title %}Mobility Database Feed URL Updates{% endblock %}
{% block header_label %}Feed URL Updates{% endblock %}
{% block preheader %}{{ rows | length }} feed URL update{{ "s" if rows | length != 1 }} detected.{% endblock %}
{% block content %}
{%- set replaced = rows | selectattr("event_subtype", "ne", "feed_redirected") | list -%}
{%- set redirected = rows | selectattr("event_subtype", "eq", "feed_redirected") | list -%}
<tr>
  <td class="px" style="padding: 28px 32px;">
    <h1 style="margin: 0 0 4px 0; font-family: Mulish, 'Segoe UI', Arial, Helvetica, sans-serif; font-size: 20px; line-height: 1.3; font-weight: 800; color: #1d1717;">Feed URL Updates</h1>
    <p style="margin: 0 0 16px 0; font-family: Mulish, 'Segoe UI', Arial, sans-serif; font-size: 11px; color: rgba(71, 71, 71, 0.8);">
      {{ rows | length }} update{{ "s" if rows | length != 1 }}
    </p>

    {% if replaced %}
    {{ section_heading("URL changes", replaced | length) }}
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #ffffff; border-radius: 4px; overflow: hidden; margin-bottom: 24px;"
    >
      <thead>
        <tr bgcolor="#ffffff" style="background-color: #ffffff">
          {{ th("Feed") }}
          {{ th("Old URL") }}
          {{ th("New URL") }}
        </tr>
      </thead>
      <tbody style="font-family: Mulish, 'Segoe UI', Arial, sans-serif; font-size: 12px;">
        {% for row in replaced %}
        {{ row_open(loop) }}
          <td style="{{ td_style(loop) }}">{{ feed_link(row.feed_url, row.provider, row.feed_stable_id) }}</td>
          <td style="{{ td_style(loop) }} word-break: break-all;">{{ row.old_url or "-" }}</td>
          <td style="{{ td_style(loop) }} word-break: break-all;">{{ row.new_url | safe_link if row.new_url else "-" }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endif %}

    {% if redirected %}
    {{ section_heading("Replaced feeds", redirected | length) }}
    <p style="margin: 0 0 8px 0; font-family: Mulish, 'Segoe UI', Arial, sans-serif; font-size: 12px; color: #474747;">
      These feeds are deprecated. Follow the new feed to keep receiving its updates.
    </p>
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #ffffff; border-radius: 4px; overflow: hidden;"
    >
      <thead>
        <tr bgcolor="#ffffff" style="background-color: #ffffff">
          {{ th("Old feed") }}
          {{ th("New feed") }}
        </tr>
      </thead>
      <tbody style="font-family: Mulish, 'Segoe UI', Arial, sans-serif; font-size: 12px;">
        {% for row in redirected %}
        {{ row_open(loop) }}
          <td style="{{ td_style(loop) }}">{{ feed_link(row.feed_url, row.provider, row.feed_stable_id) }}</td>
          <td style="{{ td_style(loop) }}">{{ feed_link(row.target_feed_url, row.target_provider, row.target_feed_stable_id) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endif %}
  </td>
</tr>
{% endblock %}

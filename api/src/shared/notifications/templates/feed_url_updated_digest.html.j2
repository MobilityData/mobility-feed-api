{% extends "_base_email.html.j2" %}
{% block title %}Mobility Database Feed URL Updates{% endblock %}
{% block header_label %}Feed URL Updates{% endblock %}
{% block preheader %}{{ rows | length }} feed URL update{{ "s" if rows | length != 1 }} detected.{% endblock %}
{% block content %}
<tr>
  <td class="px" style="padding: 28px 32px;">
    <h1 style="margin: 0 0 4px 0; font-family: Mulish, 'Segoe UI', Arial, Helvetica, sans-serif; font-size: 20px; line-height: 1.3; font-weight: 800; color: #1d1717;">Feed URL Updates</h1>
    <p style="margin: 0 0 16px 0; font-family: Mulish, 'Segoe UI', Arial, sans-serif; font-size: 11px; color: rgba(71, 71, 71, 0.8);">
      {{ rows | length }} update{{ "s" if rows | length != 1 }}
    </p>
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #ffffff; border-radius: 4px; overflow: hidden;"
    >
      <thead>
        <tr bgcolor="#ffffff" style="background-color: #ffffff">
          <th align="left" style="padding: 8px 10px; font-family: Mulish, 'Segoe UI', Arial, sans-serif; font-size: 11px; font-weight: 700; color: #474747; border-bottom: 1px solid rgba(0,0,0,0.12);">Feed</th>
          <th align="left" style="padding: 8px 10px; font-family: Mulish, 'Segoe UI', Arial, sans-serif; font-size: 11px; font-weight: 700; color: #474747; border-bottom: 1px solid rgba(0,0,0,0.12);">Type</th>
          <th align="left" style="padding: 8px 10px; font-family: Mulish, 'Segoe UI', Arial, sans-serif; font-size: 11px; font-weight: 700; color: #474747; border-bottom: 1px solid rgba(0,0,0,0.12);">Old URL</th>
          <th align="left" style="padding: 8px 10px; font-family: Mulish, 'Segoe UI', Arial, sans-serif; font-size: 11px; font-weight: 700; color: #474747; border-bottom: 1px solid rgba(0,0,0,0.12);">New URL</th>
          <th align="left" style="padding: 8px 10px; font-family: Mulish, 'Segoe UI', Arial, sans-serif; font-size: 11px; font-weight: 700; color: #474747; border-bottom: 1px solid rgba(0,0,0,0.12);">Source</th>
        </tr>
      </thead>
      <tbody style="font-family: Mulish, 'Segoe UI', Arial, sans-serif; font-size: 12px;">
        {% for row in rows %}
        {%- set is_even = loop.index0 % 2 == 1 -%}
        {%- set has_border = not loop.last -%}
        <tr{% if is_even %} bgcolor="#fafafa" style="background-color: #fafafa"{% endif %}>
          <td style="padding: 7px 10px; color: #474747;{% if has_border %} border-bottom: 1px solid rgba(0,0,0,0.06);{% endif %}">{% if row.feed_url %}<a href="{{ row.feed_url }}" target="_blank" style="color: #3959fa; font-weight: 700; text-decoration: none;">{{ row.feed_stable_id }}</a>{% else %}{{ row.feed_stable_id }}{% endif %}{% if row.provider %} ({{ row.provider }}){% endif %}</td>
          <td style="padding: 7px 10px; color: #474747;{% if has_border %} border-bottom: 1px solid rgba(0,0,0,0.06);{% endif %}">{{ row.event_subtype }}</td>
          <td style="padding: 7px 10px; color: #474747;{% if has_border %} border-bottom: 1px solid rgba(0,0,0,0.06);{% endif %}">{{ row.old_url or "-" }}</td>
          <td style="padding: 7px 10px; color: #474747;{% if has_border %} border-bottom: 1px solid rgba(0,0,0,0.06);{% endif %}">{{ row.new_url or "-" }}</td>
          <td style="padding: 7px 10px; color: #474747;{% if has_border %} border-bottom: 1px solid rgba(0,0,0,0.06);{% endif %}">{{ row.source or "-" }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </td>
</tr>
{% endblock %}

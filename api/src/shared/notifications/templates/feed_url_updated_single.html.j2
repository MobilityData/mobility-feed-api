    border: {{ border }};
  "
>
  {{ label }}
</a>
<!--<![endif]-->
{%- endmacro -%}

{% block title %}Mobility Database Feed Update — {{ row.feed_stable_id }}{% endblock %}
{% block header_label %}Feed URL Update{% endblock %}
{% block preheader %}
{%- if row.event_subtype == "feed_redirected" -%}
Feed {{ row.feed_stable_id }} has been deprecated and now redirects to {{ row.target_feed_stable_id }}.
{%- else -%}
The URL for feed {{ row.feed_stable_id }} has changed.
{%- endif -%}
{% endblock %}
{% block content %}
<tr>
  <td class="px" style="padding: 28px 32px;">
    {% if row.event_subtype == "feed_redirected" %}
    <h1 style="margin: 0 0 12px 0; font-family: Mulish, 'Segoe UI', Arial, Helvetica, sans-serif; font-size: 20px; line-height: 1.3; font-weight: 800; color: #1d1717;">Feed deprecated</h1>
    <p style="margin: 0 0 8px 0; font-family: Mulish, 'Segoe UI', Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.6; color: #474747;">
      Feed <strong style="color: #1d1717;">{{ row.feed_stable_id }}{% if row.provider %} ({{ row.provider }}){% endif %}</strong> has been deprecated and now redirects to <strong style="color: #1d1717;">{{ row.target_feed_stable_id }}{% if row.target_provider %} ({{ row.target_provider }}){% endif %}</strong>.
    </p>
    <p style="margin: 0; font-family: Mulish, 'Segoe UI', Arial, Helvetica, sans-serif; font-size: 13px; color: #474747;">
      New URL: {{ row.new_url | safe_link }}
    </p>
    {% else %}
    <h1 style="margin: 0 0 12px 0; font-family: Mulish, 'Segoe UI', Arial, Helvetica, sans-serif; font-size: 20px; line-height: 1.3; font-weight: 800; color: #1d1717;">Feed URL changed</h1>
    <p style="margin: 0 0 8px 0; font-family: Mulish, 'Segoe UI', Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.6; color: #474747;">
      The URL for feed <strong style="color: #1d1717;">{{ row.feed_stable_id }}{% if row.provider %} ({{ row.provider }}){% endif %}</strong> has changed.
    </p>
    <p style="margin: 0 0 4px 0; font-family: Mulish, 'Segoe UI', Arial, Helvetica, sans-serif; font-size: 13px; color: #474747;">
      Old URL: {{ row.old_url }}
    </p>
    <p style="margin: 0; font-family: Mulish, 'Segoe UI', Arial, Helvetica, sans-serif; font-size: 13px; color: #474747;">
      New URL: {{ row.new_url | safe_link }}
    </p>
    {% endif %}
  </td>
</tr>
{% if row.event_subtype == "feed_redirected" %}
{% if row.target_feed_url or row.feed_url %}
<!-- ============ CTA BUTTONS (redirected: new + deprecated feed) ============ -->
<tr>
  <td align="center" style="padding: 8px 32px 8px 32px;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
      <tr>
        {% if row.target_feed_url %}
        <td style="padding: 0 6px;">{{ cta_button(row.target_feed_url, "View New Feed", "filled") }}</td>
        {% endif %}
        {% if row.feed_url %}
        <td style="padding: 0 6px;">{{ cta_button(row.feed_url, "View Deprecated Feed", "outline") }}</td>
        {% endif %}
      </tr>
    </table>
  </td>
</tr>
{% endif %}
{% elif row.feed_url %}
<!-- ============ CTA BUTTON ============ -->
<tr>
  <td align="center" style="padding: 8px 32px 8px 32px;">
    {{ cta_button(row.feed_url, "View Feed", "filled") }}
  </td>
</tr>
{% endif %}
{% endblock %}

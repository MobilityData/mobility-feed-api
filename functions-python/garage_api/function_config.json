{
  "name": "garage-api",
  "description": "API for a user's datasets in the GTFS Garage",
  "entry_point": "main",
  "path": "/v1/garage/*",
  "timeout": 60,
  "memory": "512Mi",
  "trigger_http": true,
  "include_folders": ["helpers"],
  "include_api_folders": ["common", "database", "users_database_gen", "middleware"],
  "environment_variables": [
    {
      "key": "CORS_ALLOWED_ORIGINS"
    },
    {
      "key": "GARAGE_BUCKET_NAME"
    }
  ],
  "secret_environment_variables": [
    {
      "key": "USERS_DATABASE_URL"
    },
    {
      "key": "S2S_JWT_SECRET"
    }
  ],
  "ingress_settings": "ALLOW_INTERNAL_AND_GCLB",
  "max_instance_request_concurrency": 80,
  "max_instance_count": 10,
  "min_instance_count": 0,
  "available_cpu": 1,
  "build_settings": {
    "pre_build_script": "../../scripts/api-garage-gen.sh"
  }
}

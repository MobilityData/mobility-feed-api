<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
  http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

  <changeSet id="rebuild-feed-search-mv" author="you" runOnChange="true">
    <sql>DROP MATERIALIZED VIEW IF EXISTS feedsearch;</sql>

    <sqlFile
      path="feed_search.sql"
      relativeToChangelogFile="true"
      splitStatements="false"
      endDelimiter=";"/>
  </changeSet>

  <changeSet id="rebuild-geopolygon-location-search-mv" author="you" runOnChange="true">
    <sql>DROP MATERIALIZED VIEW IF EXISTS geopolygonlocationsearch;</sql>

    <sqlFile
      path="geopolygon_location_search.sql"
      relativeToChangelogFile="true"
      splitStatements="false"
      endDelimiter=";"/>
  </changeSet>

  <!-- Feed counts of the location directory. Depends on the continent tables, so it is rebuilt after them. -->
  <changeSet id="rebuild-location-feed-count-mv" author="you" runOnChange="true">
    <sql>DROP MATERIALIZED VIEW IF EXISTS locationfeedcount;</sql>

    <sqlFile
      path="location_feed_count.sql"
      relativeToChangelogFile="true"
      splitStatements="false"
      endDelimiter=";"/>
  </changeSet>

</databaseChangeLog>
